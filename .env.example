# ------------------------- Common -------------------------
# Log level: debug, info, warn or error.
LOG_LEVEL=info
# Log format: json or text.
LOG_FORMAT=json
LOG_SLOW_REQUEST_THRESHOLD=1s
SHUTDOWN_TIMEOUT=15s
# Optional delay after readiness turns false during graceful shutdown.
SHUTDOWN_DRAIN_DELAY=0s
# When behind a reverse proxy, trust only its actual address(es).
# Otherwise the direct peer is used for rate limiting and request logs.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ------------------------- NEPSE upstream -------------------------
NEPSE_BASE_URL=https://www.nepalstock.com
NEPSE_TIMEOUT=30s
NEPSE_MAX_RESPONSE_BYTES=8388608
# Per-symbol floorsheet queries scan the latest all-market session and filter
# locally because NEPSE blocks its per-symbol endpoint. These settings bound
# the scan; the default supports up to 100 pages / 50,000 rows.
NEPSE_MAX_FLOOR_PAGES=100
NEPSE_MAX_FLOOR_ROWS=50000
NEPSE_CACHE_TTL=5s
NEPSE_MAX_STALE=1m
# Optional custom trusted CA bundle.
# NEPSE_CA_BUNDLE=/etc/ssl/certs/custom-nepse-ca.pem
# Optional upstream User-Agent override.
# NEPSE_USER_AGENT=
# Testing only; production-stamped binaries refuse these settings.
# NEPSE_INSECURE_SKIP_VERIFY=true
# NEPSE_ALLOW_INSECURE_HTTP=true

# ------------------------- REST service -------------------------
REST_HOST=127.0.0.1
REST_PORT=8000
REST_READ_TIMEOUT=5s
REST_WRITE_TIMEOUT=30s
REST_IDLE_TIMEOUT=60s
# Must be shorter than REST_WRITE_TIMEOUT.
# REST_REQUEST_TIMEOUT=25s
REST_MAX_CONCURRENT=64
# Per client IP; set to 0 to disable.
REST_RATE_LIMIT_PER_MINUTE=120
REST_DOCS_ENABLED=true
# Optional browser CORS allowlist, comma-separated; no wildcard.
# REST_ALLOWED_ORIGINS=https://internal-app.example.com

# ------------------------- MCP service -------------------------
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_TOOL_TIMEOUT=30s
MCP_MAX_CONCURRENT=32
MCP_RATE_LIMIT_PER_MINUTE=120
# Optional browser Origin allowlist, comma-separated.
# MCP_ALLOWED_ORIGINS=https://internal-mcp-client.example.com
